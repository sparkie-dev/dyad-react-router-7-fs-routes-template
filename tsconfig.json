{
  "include": [".react-router/types/**/*", "src"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@prisma-client/*":["./src/prisma/generated/*"]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext"
  }
}
